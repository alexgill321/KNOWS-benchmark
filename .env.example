# --- Required ---

# Google AI Studio API key for the LLM/VLM judge (https://aistudio.google.com/)
# Alternative: leave unset and configure Vertex AI ADC via GOOGLE_CLOUD_PROJECT.
GOOGLE_AI_API_KEY=

# Path to the evaluator's Google service-account JSON key.
# Defaults to ./auth-data/service-account.json if unset.
# SERVICE_ACCOUNT_PATH=

# --- Optional (Vertex AI judge fallback) ---
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Optional task-specific keys ---
# USDA FoodData Central key (sheets_2 nutrient fallback checks; free at https://fdc.nal.usda.gov/api-key-signup)
# USDA_API_KEY=
# Google Maps Platform key (sheets_28 Places/Directions seeding; checks degrade to LLM judgements without it)
# GOOGLE_MAPS_API_KEY=
# Semantic Scholar key (docs_5; raises rate limits, works without)
# S2_API_KEY=
# Hugging Face token (only for optional local judge models)
# HF_KEY=
